require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

def app_store_connect_api_key_from_env
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: true
  )
end

# BUILD_NUMBER wins; otherwise uploads continue from the latest TestFlight build, since CI
# never commits the bumped number back. The workflow passes an empty string on tag pushes.
def bump_build_number(api_key: nil)
  build_number = ENV["BUILD_NUMBER"].to_s.strip
  if build_number.empty? && api_key
    build_number = (latest_testflight_build_number(api_key: api_key, initial_build_number: 1) + 1).to_s
  end

  if build_number.empty?
    increment_build_number(xcodeproj: "RouteTrace.xcodeproj")
  else
    increment_build_number(
      xcodeproj: "RouteTrace.xcodeproj",
      build_number: build_number
    )
  end
end

def export_options
  "ExportOptions.plist"
end

# build_app takes no API key, so hand it to xcodebuild for automatic (cloud) signing on
# runners without local certificates or profiles.
def signing_xcargs
  key_path = File.join(Dir.tmpdir, "AuthKey_routetrace.p8")
  File.write(key_path, Base64.decode64(ENV.fetch("APP_STORE_CONNECT_API_KEY")), perm: 0o600)
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", key_path,
    "-authenticationKeyID", ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    "-authenticationKeyIssuerID", ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
  ].shelljoin
end

platform :ios do
  desc "Archive and export an App Store IPA (no upload)"
  lane :build do
    setup_ci if ENV["CI"]
    bump_build_number

    build_app(
      scheme: "RouteTrace",
      export_method: "app-store",
      export_options: export_options,
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = app_store_connect_api_key_from_env
    bump_build_number(api_key: api_key)

    # gym passes xcargs to both archive and export.
    build_app(
      scheme: "RouteTrace",
      export_method: "app-store",
      export_options: export_options,
      xcargs: signing_xcargs
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
